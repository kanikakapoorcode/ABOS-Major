# ============================================================
#  ABOS — Environment Variables (copy to .env and fill in)
# ============================================================

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_DEBUG=true

# --- LLM Providers (LiteLLM will pick based on ACTIVE_LLM) ---
ACTIVE_LLM=gemini/gemini-1.5-pro        # or openai/gpt-4o
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=abos
POSTGRES_USER=abos_user
POSTGRES_PASSWORD=abos_password
DATABASE_URL=postgresql+asyncpg://abos_user:abos_password@localhost:5432/abos

# --- pgvector ---
# (uses same PostgreSQL instance — no extra config needed)

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- JWT Auth ---
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OAuth2 (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=abos-experiments

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
