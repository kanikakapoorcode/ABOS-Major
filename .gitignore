.pytest_cache/
.coverage
htmlcov/
coverage.xml

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
powershell.bat

# Logs & temp files
*.log
logs/
workflow_*.txt
*.tmp

# Frontend dependencies and builds
**/node_modules/
**/dist/
